  {
    "script": "backup",
    "name": "B3 happy path writes all files",
    "args": [],
    "env": {
      "TV_IP": "192.168.1.50"
    },
    "tv": {
      "state": "device",
      "packages": [
        "com.android.systemui",
        "com.example.junk"
      ],
      "disabled": [
        "com.example.junk"
      ],
      "home": "com.example/.Home",
      "getprop": "[ro.product.model]: [TV]"
    },
    "expect": {
      "exit": 0,
      "files_absent": [
        "backups/*.partial"
      ],
      "files_contain": {
        "backups/*/packages-all.txt": [
          "package:com.android.systemui"
        ],
        "backups/*/packages-disabled.txt": [
          "package:com.example.junk"
        ],
        "backups/*/getprop.txt": [],
        "backups/*/settings-global.txt": [],
        "backups/*/settings-secure.txt": [],
        "backups/*/settings-system.txt": [],
        "backups/*/home-activity.txt": []
      },
      "adb_calls_include": [
        "shell pm list packages -d",
        "settings list secure",
        "resolve-activity"
      ],
      "stdout_last_line_matches": "backups[/\\\\]\\d{4}-\\d{2}-\\d{2}_\\d{6}$"
    }
  },
