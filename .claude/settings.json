{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/keystore.properties)",
      "Read(./**/signing.properties)",
      "Read(./photos/**)",
      "Read(./screenshots/**)",
      "Read(./user-content/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tv-safety.py\""
          }
        ]
      }
    ]
  }
}
