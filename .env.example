# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is git-ignored. Never commit it, and never put real values in this file.

# Your TV's address on your home network (TV: Settings → Network → About)
TV_IP=192.168.1.50

# ADB port on the TV (5555 is the Android default)
TV_ADB_PORT=5555

# Optional. Where backups are written, relative to the repo root or absolute (default: backups)
# TV_BACKUP_DIR=backups

# Optional. Path to adb (default: tools/platform-tools/adb if present, else adb on your PATH)
# ADB=adb
